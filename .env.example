# Copy to .env and adjust. Never commit .env.
RESUMEFIT_DATABASE_URL=sqlite:///./resumefit.db

# "sentence-transformers" = real model (downloads ~90 MB on first run)
# "hashing" = no download, for tests and quick local checks only
RESUMEFIT_EMBEDDING_BACKEND=sentence-transformers
RESUMEFIT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Limits (PRD defaults)
RESUMEFIT_RESUME_MAX_MB=5
RESUMEFIT_RESUME_MAX_PAGES=5
RESUMEFIT_JD_MAX_MB=5
RESUMEFIT_JD_MAX_PAGES=10
RESUMEFIT_JD_MIN_CHARS=200
RESUMEFIT_JD_MAX_CHARS=10000

# Scoring: starting values, tune on the dev split of your labelled pairs
RESUMEFIT_W_SKILL=0.5
RESUMEFIT_W_SEMANTIC=0.5
RESUMEFIT_STRONG_THRESHOLD=70
RESUMEFIT_PARTIAL_THRESHOLD=45
RESUMEFIT_SYNONYM_THRESHOLD=0.80
RESUMEFIT_WEAK_SECTION_THRESHOLD=0.35

# Coach (Phase 2)
# "none" = retrieval-only: the coach shows the most relevant passages, no generated text.
# "openai-compatible" = any server offering the chat-completions HTTP format, hosted or
# local. Set the base URL (ending in /v1 for most servers), the model name and, for hosted
# providers, the key. Only redacted passages are sent. Name your provider in the README
# privacy note before sharing the app.
RESUMEFIT_LLM_PROVIDER=none
RESUMEFIT_LLM_BASE_URL=
RESUMEFIT_LLM_MODEL=
RESUMEFIT_LLM_API_KEY=
RESUMEFIT_LLM_TIMEOUT_S=8
RESUMEFIT_COACH_TOP_K=5
# Passages less similar to the question than this are ignored. Untuned starting value.
RESUMEFIT_COACH_MIN_SIMILARITY=0.25

RESUMEFIT_RETENTION_DAYS=30
RESUMEFIT_LOG_LEVEL=INFO

# Used by the Streamlit UI
RESUMEFIT_API_URL=http://127.0.0.1:8000
