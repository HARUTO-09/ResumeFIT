# Copy to .env and adjust. Never commit .env.
RESUMEFIT_DATABASE_URL=sqlite:///./resumefit.db

# "sentence-transformers" = real model (downloads ~90 MB on first run)
# "hashing" = no download, for tests and quick local checks only
RESUMEFIT_EMBEDDING_BACKEND=onnx
RESUMEFIT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Limits (PRD defaults)
RESUMEFIT_RESUME_MAX_MB=5
RESUMEFIT_RESUME_MAX_PAGES=5
RESUMEFIT_JD_MAX_MB=5
RESUMEFIT_JD_MAX_PAGES=10
RESUMEFIT_JD_MIN_CHARS=200
RESUMEFIT_JD_MAX_CHARS=10000

# Scoring: starting values, tune on the dev split of your labelled pairs
RESUMEFIT_W_SKILL=0.5
RESUMEFIT_W_SEMANTIC=0.5
RESUMEFIT_STRONG_THRESHOLD=70
RESUMEFIT_PARTIAL_THRESHOLD=45
RESUMEFIT_SYNONYM_THRESHOLD=0.80
RESUMEFIT_WEAK_SECTION_THRESHOLD=0.35

# Coach (Phase 2)
# "none" = retrieval-only: the coach shows the most relevant passages, no generated text.
# "openai-compatible" = any server offering the chat-completions HTTP format, hosted or
# local. Set the base URL (ending in /v1 for most servers), the model name and, for hosted
# providers, the key. Only redacted passages are sent. Name your provider in the README
# privacy note before sharing the app.
# Local example (Ollama, nothing leaves the machine; install Ollama, then
# `ollama pull qwen2.5:3b`). A 3B model on a laptop CPU needs a timeout near 60 s:
#   RESUMEFIT_LLM_PROVIDER=openai-compatible
#   RESUMEFIT_LLM_BASE_URL=http://127.0.0.1:11434/v1
#   RESUMEFIT_LLM_MODEL=qwen2.5:3b
#   RESUMEFIT_LLM_TIMEOUT_S=60
RESUMEFIT_LLM_PROVIDER=none
RESUMEFIT_LLM_BASE_URL=
RESUMEFIT_LLM_MODEL=
RESUMEFIT_LLM_API_KEY=
RESUMEFIT_LLM_TIMEOUT_S=8
RESUMEFIT_COACH_TOP_K=5
# Passages less similar to the question than this are ignored. Untuned starting value.
RESUMEFIT_COACH_MIN_SIMILARITY=0.25

# Accounts (Phase 3): Firebase Authentication. Copy these from the Firebase console
# (Project settings > Your apps > Web app config). They are public identifiers, not
# secrets; the API serves them to the UI at /auth/config. Without the project id,
# every endpoint except /health answers 503.
RESUMEFIT_FIREBASE_PROJECT_ID=
RESUMEFIT_FIREBASE_API_KEY=
RESUMEFIT_FIREBASE_AUTH_DOMAIN=
# Deleting an account needs a sign-in at most this many seconds old.
RESUMEFIT_RECENT_LOGIN_SECONDS=300
# Comma-separated emails that can open the admin metrics page (must be verified in Firebase).
RESUMEFIT_ADMIN_EMAILS=
# Browser origins of the web front end in web/ that may call the API, comma-separated,
# e.g. http://localhost:5500,https://your-site.vercel.app. Empty turns CORS off.
RESUMEFIT_CORS_ORIGINS=http://localhost:5500

# Daily quotas per user (UTC days). Raise them for a load test.
RESUMEFIT_QUOTA_ANALYSES_PER_DAY=20
RESUMEFIT_QUOTA_COACH_PER_DAY=50

# Monitoring: starting thresholds from the PRD
RESUMEFIT_METRICS_WINDOW_DAYS=7
RESUMEFIT_DRIFT_MEAN_SHIFT=10
RESUMEFIT_DRIFT_KS_ALPHA=0.01
RESUMEFIT_DRIFT_MIN_SAMPLES=20
RESUMEFIT_RATING_FLAG_BELOW=3.5

RESUMEFIT_RETENTION_DAYS=30
RESUMEFIT_LOG_LEVEL=INFO

# Used by the Streamlit UI
RESUMEFIT_API_URL=http://127.0.0.1:8000
